{
  "name": "@dnbhq/markdownlint-config",
  "description": "Shared markdownlint configuration for DNBHQ projects.",
  "version": "1.0.0",
  "license": "MIT",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidsneighbour/markdownlint-config.git"
  },
  "author": "Patrick Kollitsch <davidsneighbourdev+gh@gmail.com> (https://davids-neighbour.com)",
  "bugs": "https://github.com/davidsneighbour/markdownlint-config/issues",
  "homepage": "https://github.com/davidsneighbour/markdownlint-config#readme",
  "dependencies": {
    "@github/markdownlint-github": "^0.8.4",
    "markdownlint": "^0.41.1",
    "markdownlint-cli2": "^0.23.3",
    "markdownlint-rule-extended-ascii": "^0.2.1",
    "markdownlint-rule-relative-links": "^5.1.3",
    "markdownlint-rule-search-replace": "^1.2.0",
    "markdownlint-rule-title-case-style": "^0.4.3"
  },
  "devDependencies": {
    "@dnbhq/release-config": "2.0.0",
    "@dnbhq/tsconfig": "0.1.6",
    "@release-it/conventional-changelog": "12.0.0",
    "@types/node": "26.6.4",
    "lint-staged": "17.3.0",
    "markdown-it": "15.0.1",
    "release-it": "21.0.2",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2"
  },
  "scripts": {
    "check": "npm run lint && npm run validate:types && npm run test",
    "lint": "markdownlint-cli2 --config .markdownlint-cli2.jsonc README.md",
    "lint:staged": "lint-staged",
    "prepare": "simple-git-hooks",
    "release": "release-it --ci",
    "release:dry": "release-it --dry-run",
    "release:patch": "release-it patch --ci",
    "release:minor": "release-it minor --ci",
    "release:major": "release-it major --ci",
    "test": "node --test test/",
    "validate:types": "tsc --noEmit"
  },
  "main": ".markdownlint-cli2.jsonc",
  "files": [
    ".markdownlint-cli2.jsonc",
    "rules/*.mjs",
    ".markdownlintignore",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "overrides": {
    "markdownlint-rule-title-case-style": {
      "markdownlint": "$markdownlint"
    },
    "get-uri": {
      "basic-ftp": "^6.2.1"
    },
    "release-it": {
      "undici": "^7.29.1"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=26"
  },
  "exports": {
    ".": "./.markdownlint-cli2.jsonc",
    "./config": "./.markdownlint-cli2.jsonc",
    "./.markdownlint-cli2.jsonc": "./.markdownlint-cli2.jsonc",
    "./ignore": "./.markdownlintignore",
    "./.markdownlintignore": "./.markdownlintignore"
  },
  "lint-staged": {
    "*.{md,mdx}": [
      "markdownlint-cli2 --config .markdownlint-cli2.jsonc --fix --no-globs"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged --allow-empty"
  },
  "type": "module"
}
